// QAForge Prisma Schema
// V0.1 Foundation: User and Project models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  projects            Project[]

  @@map("users")
}

enum ProjectStatus {
  Active
  Draft
  Archived

  @@map("project_status")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  targetUrl   String?
  status      ProjectStatus @default(Active)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@map("projects")
}