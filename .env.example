# ==================================================
# QAForge Environment Configuration
# ==================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# All variables are validated at startup via src/lib/env.ts
# ==================================================

# ----- Application --------------------------------
NODE_ENV=development

# The public URL of this application instance.
# Used for absolute URL generation and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Database -----------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/qaforge_dev

# ----- Authentication --------------------------------
# Required by iron-session for cookie encryption.
# Generate with: openssl rand -base64 32 (must be at least 32 chars)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
SESSION_SECRET=

# ----- Password Reset --------------------------------
# Base URL used when constructing reset-password links in emails.
# Defaults to NEXT_PUBLIC_APP_URL if not set.
APP_URL=http://localhost:3000

# ----- Future Variables (do not use in V0.1) ------
# These are documented here for planning purposes only.
# Do not add logic that reads these in V0.1.
#
# V0.4 - URL scanning SSRF protection
# SSRF_ALLOWED_SCHEMES=https
# SSRF_BLOCK_PRIVATE_IP=true

# ----- Google OAuth --------------------------------
# Required for Google sign-in. Create credentials at:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
